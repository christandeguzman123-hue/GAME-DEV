{
  "name": "space-defender",
  "version": "1.0.0",
  "description": "Space Defender",
  "main": "main.js",
  "author": "Space Defender",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.spacedefender.app",
    "productName": "Space Defender",
    "files": [
      "main.js",
      "index.html",
      "style.css",
      "game.js",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
